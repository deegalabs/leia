# LeIA · serviço cognitivo (FastAPI). Copie para .env e preencha. Nunca versione o .env.
GROQ_API_KEY=                 # modelo principal do workflow (openai/gpt-oss-120b)
FALLBACK_PROVIDER=            # anthropic | openai (opcional, usado se a Groq falhar)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BASE_URL=http://localhost:8000   # usado no QR do comprovante (troque pela URL pública no deploy)
OTS_ENABLED=true              # carimbo OpenTimestamps (sem carteira)
ANCHOR_CHAIN=                 # vazio | amoy | polygon (só com carteira financiada)
AMOY_RPC_URL=https://polygon-amoy.drpc.org
ANCHOR_PRIVATE_KEY=           # carteira do relayer, nunca a pessoal
CONSENT_REGISTRY_ADDRESS=
