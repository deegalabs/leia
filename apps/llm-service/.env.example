# LeIA · serviço cognitivo (FastAPI). Copie para .env ou defina no Railway. Nunca versione segredos.
GROQ_API_KEY=                      # chave da Groq (obrigatória para o workflow); API_KEY é aceita como legado
GROQ_MODEL=openai/gpt-oss-120b     # modelo padrão do workflow
ADMIN_EMAIL=admin@local            # usuário criado no primeiro boot
ADMIN_PASSWORD=trocar123           # troque em produção
ADMIN_NAME=Administrador
DATA_DIR=.                         # pasta persistente: gestao.db e workspace/ (Railway: /data com volume)
# DB_PATH= e WORKSPACE_DIR= sobrescrevem os caminhos individualmente
CORS_ORIGINS=http://localhost:3000 # origens do app (separadas por vírgula), ex.: https://leia-snowy.vercel.app
CLIENT_APP_URL=                    # base do app da cidadã para o "link da cliente" (vazio = este serviço)
BASE_URL=http://localhost:8000     # URL pública deste serviço (entra no QR do comprovante)
OTS_ENABLED=true                   # carimbo OpenTimestamps das tentativas aprovadas
PORT=8000
