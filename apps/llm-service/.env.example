# LeIA · serviço cognitivo (FastAPI). Copie para .env ou defina no Railway. Nunca versione segredos.
GROQ_API_KEY=                      # chave da Groq (obrigatória para o workflow); API_KEY é aceita como legado
GROQ_MODEL=openai/gpt-oss-120b     # modelo padrão do workflow
ADMIN_EMAIL=admin@local            # usuário criado no primeiro boot
ADMIN_PASSWORD=trocar123           # troque em produção
ADMIN_NAME=Administrador
DATA_DIR=.                         # pasta persistente: gestao.db e workspace/ (Railway: /data com volume)
# DB_PATH= e WORKSPACE_DIR= sobrescrevem os caminhos individualmente
DATABASE_URL=                      # Postgres: no Railway, referência ${{Postgres.DATABASE_URL}}; vazio = SQLite em DB_PATH
ADVOGADO_SIGNUP=true               # false fecha o cadastro de advogados em POST /api/auth/cadastro (cidadã continua aberto)
PIPELINE_CONCURRENCY=3             # quantos documentos são preparados ao mesmo tempo (semáforo do workflow)
RATE_LIMIT_PER_MINUTE=30           # limite por IP nas rotas públicas de escrita (quiz, chat, dúvida, cadastro, login)
CORS_ORIGINS=http://localhost:3000 # origens do app (separadas por vírgula), ex.: https://leia-snowy.vercel.app
CLIENT_APP_URL=                    # base do app da cidadã para o "link da cliente" (vazio = este serviço)
BASE_URL=http://localhost:8000     # URL pública deste serviço (entra no QR do comprovante)
OTS_ENABLED=true                   # carimbo OpenTimestamps das tentativas aprovadas
PORT=8000
SESSION_COOKIE_SECURE=false        # true atrás de HTTPS (Railway)
LOG_LEVEL=INFO
QUIZ_MAX_ATTEMPTS=3                # teto de tentativas de conferência por documento
QUIZ_PASS_RATIO=0.83               # fração de acertos para aprovar (int(total * ratio))
PIPELINE_TEMPERATURE=0.0
PIPELINE_MAX_TOKENS=8000
PDF_PROTOCOL_FILE=                 # vazio = protocolo_pdf.json ao lado do código
PERSISTENT_CONTEXT_FILE=           # vazio = $DATA_DIR/contexto_persistente.json
CITIZEN_CHAT_TEMPERATURE=0.3
CITIZEN_CHAT_MAX_TOKENS=1500
CITIZEN_CHAT_MEMORY_CHARS=12000
RESUMO_ESTRUTURADO_API_BASE=https://api.resumoestruturado.com.br   # APIs externas do painel (sem autenticação)
JURISPRUDENCIA_API_BASE=https://api.jurisprudencia.com.br
EXTERNAL_POLL_INTERVAL=1.5
EXTERNAL_POLL_TIMEOUT=600
EXTERNAL_HTTP_TIMEOUT=60
BRAND_NAME=LeIA                    # marca no PDF assinado do serviço
DOCS_ENABLED=false                 # /docs, /redoc e /openapi.json só quando true
MAX_UPLOAD_MB=15
RATE_LIMIT_PROXY_HOPS=1             # quantos proxies nossos a requisição atravessa; 1 atrás da plataforma, 0 sem proxy
