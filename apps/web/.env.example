# Serviço cognitivo. Vazio: o app responde pelo mock interno (app/api/*), que é a demonstração hospedada.
# Sem NEXT_PUBLIC_: a URL fica no servidor do app, e é ele quem fala com o serviço. O navegador só fala com o app,
# que é o que permite a sessão viver num cookie inacessível a script.
SERVICE_URL=

# Tarefa real usada pelo "Ver um exemplo" da página inicial.
NEXT_PUBLIC_DEMO_HASH=
